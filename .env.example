# Required for the AI features (reading the prescription bottle photo and
# comparing pill photos), which run on Google Vertex AI (Gemini). Without
# credentials the app still runs, but bottle reading and pill checks show
# "AI is not available right now" and the person types details by hand.
#
# Set ONE of these two (Cloudflare: `wrangler secret put <NAME>`):
#
# a) Express-mode API key — simplest. Create one in the Google Cloud console
#    (Vertex AI / Agent Platform → express mode → API keys).
GOOGLE_VERTEX_API_KEY=
#
# b) A service account key — the usual production setup. In the Google
#    Cloud console: IAM → Service accounts → create one with the
#    "Vertex AI User" role → Keys → Add key → JSON. Paste the WHOLE file
#    contents as the value (one line is fine).
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Optional (service account only): project and region. The project defaults
# to the key file's project_id; "global" gives the best availability.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
#
# Optional: the Gemini model (default gemini-3.6-flash) and its thinking
# level (default low — these are quick reads and an older adult is waiting).
VERTEX_MODEL=gemini-3.6-flash
VERTEX_THINKING_LEVEL=low

# Required for the caregiver-pairing feature (family code, activity feed,
# missed-dose alerts) to work once deployed. A local run with nothing set
# here falls back to an in-memory embedded Postgres, which is fine for
# trying the app on one machine but is NOT shared across devices — a
# caregiver's phone and the patient's phone must both reach the SAME real
# database, so this is required in production. Get a free Postgres at
# https://neon.tech and set the pooled connection string here (Cloudflare:
# `wrangler secret put DATABASE_URL`).
DATABASE_URL=

# Required for push notifications to the caregiver's phone (dose taken +
# missed-dose alerts). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# (the CLI is fine to run locally even though the app itself does not use
# that package's runtime code — see src/lib/push.server.ts for why).
# VITE_VAPID_PUBLIC_KEY is not secret and is bundled into the client build.
# VAPID_PRIVATE_KEY is a secret — never commit it or expose it to the client.
# VAPID_SUBJECT must be "mailto:you@example.com" or an https:// URL — it's
# how push services can contact you if something's wrong with your usage.
# Without all three, push notifications are silently skipped — everything
# else (reminders, the one-tap SMS, the caregiver's activity feed) still
# works, the caregiver just has to open the app to see updates instead of
# getting a phone notification.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Recommended before launch: a free openFDA API key (https://open.fda.gov/apis/authentication/).
# The app checks each new medicine against the FDA drug directory. Without a
# key openFDA allows 1,000 requests a day per IP address; with one it allows
# far more. Needed for seeding the drug cache (scripts/seed-drug-cache.mjs).
# Cloudflare: `wrangler secret put OPENFDA_API_KEY`. DailyMed and RxNorm need no key.
OPENFDA_API_KEY=

# Optional: enables POST /api/drug-cache/warm, used only by
# scripts/seed-drug-cache.mjs to pre-fill the official drug cache for common
# medicines. Any random string of 16+ characters, e.g. `openssl rand -hex 24`.
# Leave empty to keep the endpoint switched off (it returns 404).
DRUG_CACHE_ADMIN_TOKEN=
