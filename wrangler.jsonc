{
  "name": "suredose-test",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  // Official pill photos from FDA labels (DailyMed), cached by
  // src/lib/drug-lookup.server.ts. Create the bucket once with:
  //   npx wrangler r2 bucket create suredose-pill-images
  // Keep it private — photos are served through the app.
  "r2_buckets": [
    {
      "binding": "PILL_IMAGES",
      "bucket_name": "suredose-pill-images"
    }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "suredose",
    "database_id": "f0ff8234-58ff-420f-9ffa-b5363ed713ad",
    "migrations_dir": "migrations/d1"
  }],
  "observability": {
    "enabled": true
  }
}
