{
  "name": "suredose",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  // Official pill photos from FDA labels (DailyMed), cached by
  // src/lib/drug-lookup.server.ts. Create the bucket once with:
  //   npx wrangler r2 bucket create suredose-pill-images
  // Keep it private — photos are served through the app.
  "r2_buckets": [
    {
      "binding": "PILL_IMAGES",
      "bucket_name": "suredose-pill-images"
    }
  ],
  // Care circle, drug cache and pill library. Create the database once with
  //   npx wrangler d1 create suredose
  // then replace database_id below with the id it prints. Apply the schema
  // with `npm run d1:migrate:remote` (or `d1:migrate:local` for local dev).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suredose",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
